// Claude Code Global Settings
//
// Installed to ~/.claude/settings.json by install.sh (copy, not symlink).
// Claude Code writes to this file when you approve permissions per-session,
// so it must be a real file, not a symlink.
//
// After modifying this template, re-run install.sh or manually copy:
//   cp ~/Projects/claude-code-toolkit/claude-md/settings-global.jsonc ~/.claude/settings.json
{
  "permissions": {
    "allow": [
      // ── File operations ───────────────────────────────────────
      // Write and Edit are always needed — without these, every file
      // modification triggers a permission prompt.
      "Write",
      "Edit",
      "MultiEdit",

      // ── Shell utilities ───────────────────────────────────────
      // Basic read-only commands. Low risk, constantly used during
      // codebase exploration.
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(echo *)",
      "Bash(printf *)",

      // ── File management ───────────────────────────────────────
      // Creating directories and copying/moving files. Needed for
      // project scaffolding and file organization.
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(tee *)",

      // ── Git & GitHub ──────────────────────────────────────────
      // Core workflow tools. Destructive git operations (force push,
      // reset --hard) are caught by the block-destructive hook.
      "Bash(git *)",
      "Bash(gh *)",

      // ── Docker ────────────────────────────────────────────────
      "Bash(docker *)",

      // ── Node.js ───────────────────────────────────────────────
      "Bash(npm *)",
      "Bash(npx *)",

      // ── Python ────────────────────────────────────────────────
      // Direct python/ruff/uv invocations. For venv binaries, prefer
      // ~/.claude/bin/venv-run.sh (auto-detects venv).
      "Bash(python *)",
      "Bash(*/python *)",
      "Bash(ruff *)",
      "Bash(*/ruff *)",
      "Bash(uv *)",
      "Bash(*/uv *)",
      "Bash(source *)",

      // ── Toolkit ───────────────────────────────────────────────
      // Helper scripts and hooks from the toolkit's bin/ directory.
      "Bash(~/.claude/bin/*)",

      // ── System ────────────────────────────────────────────────
      "Bash(xdg-open *)",
      "Read(~/Pictures/Screenshots/**)",
      "Read(~/.claude/**)",

      // ── Temp files ────────────────────────────────────────────
      // Allow writing/editing temp files for commit messages, issue
      // bodies, and other intermediary files.
      "Write(/tmp/*)",
      "Edit(/tmp/*)"
    ],
    "deny": [
      // ── Destructive operations ────────────────────────────────
      // Hard deny — Claude will warn and ask for confirmation.
      // The block-destructive hook provides additional pattern-based
      // protection (force push, reset --hard, DROP TABLE, etc.).
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "alwaysThinkingEnabled": true,

  // ── Environment ─────────────────────────────────────────────────
  // PLAYWRIGHT_MCP_OUTPUT_DIR: where the Playwright MCP server writes
  //   screenshots, traces and console logs.
  //
  //   Without it, the server's output directory defaults to its working
  //   directory — which is the repository you are working in. A screenshot
  //   taken WITHOUT a filename still lands in a `.playwright-mcp/` subdir
  //   (commonly gitignored), but passing a `filename` writes a relative path
  //   straight into the repo root, where nothing ignores it. That leaves an
  //   untracked image one `git add .` away from being committed, in every
  //   repo, forever.
  //
  //   Pointing it at a fixed directory outside any checkout fixes it once for
  //   all projects instead of asking each repo for its own gitignore rule.
  //   Verified against @playwright/mcp 0.0.79, which documents the variable
  //   and its `--output-dir` equivalent.
  //
  //   __HOME__ is replaced with the real home directory by install.sh. It is
  //   NOT a syntax Claude Code understands: an `env` value is passed to the
  //   subprocess as a literal string, so neither `~` nor `${HOME}` is expanded
  //   here — Playwright would resolve `~` into a directory actually named `~`.
  //   (The `~/.claude/bin/...` hook commands lower down do work, because those
  //   are run through a shell, which expands the tilde itself.)
  "env": {
    "PLAYWRIGHT_MCP_OUTPUT_DIR": "__HOME__/.claude/playwright-output"
  },

  // ── Hooks ───────────────────────────────────────────────────────
  // Pre-tool hooks run BEFORE a tool executes. They work in ALL
  // permission modes, including bypass-permissions.
  //
  // auto-approve: approves safe compound commands (redirects, pipes,
  //   && chains, for loops) that permission matching would block.
  // block-destructive: catches dangerous patterns (force push,
  //   rm -rf, DROP TABLE, etc.). Exit code 2 = block.
  // block-foreign-worktree-git: blocks git checkout/restore/reset/clean/stash
  //   aimed via -C at a sibling worktree of the same repo, where it would
  //   silently discard another session's uncommitted work.
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/hook-auto-approve-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/hook-block-destructive.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/hook-block-foreign-worktree-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/hook-post-edit-lint.sh"
          }
        ]
      },
      {
        // Adds the Co-Authored-By trailer to agent-authored commits when it is
        // missing. Repos that gate heightened review on an `agent-authored`
        // label never apply that label without the trailer, so the required
        // checklist silently never runs. Deliberately NOT in git-commit.sh:
        // that wrapper is also used by the human maintainer, and a trailer
        // there would label human commits as agent-authored.
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/hook-post-commit-trailer.sh"
          }
        ]
      }
    ]
  }
}
